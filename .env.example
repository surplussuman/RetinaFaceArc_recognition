# Example .env for RetinaFaceArc_recognition
# Copy this to .env and edit values for your environment.

# RTSP source (camera or media server)
RTSP_URL=rtsp://<HOST_OR_IP>:8554/<path>

# Stream resize to avoid excessive RAM use in backend
MAX_STREAM_WIDTH=640
MAX_STREAM_HEIGHT=360

# MJPEG stream settings served by backend
MJPEG_FPS=15
MJPEG_QUALITY=60

# Backend host and port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=9002
